{
  "name": "@iankiku/forwward-teams",
  "version": "0.5.0",
  "description": "Lean agent skills for building, shipping, strategy, and growth — no context bloat.",
  "type": "module",
  "bin": {
    "fwd": "bin/cli.js",
    "forwward": "bin/cli.js",
    "forwward-teams": "bin/cli.js"
  },
  "files": [
    "skills/",
    "hooks/",
    "scripts/cli",
    "bin/",
    "marketplace.json",
    ".claude-plugin/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "postinstall": "node -e \"console.log('\\n  forwward-teams installed.\\n  Run: npx fwd skills install\\n  Or:  npx fwd skills install -g (global)\\n')\"",
    "pack": "npm pack --pack-destination dist",
    "clean": "rm -rf dist",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "keywords": [
    "claude-code",
    "agent-skills",
    "skills",
    "gemini",
    "cursor",
    "codex",
    "opencode",
    "ai-agents",
    "founder",
    "startup"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iankiku/forwward-teams.git"
  },
  "homepage": "https://github.com/iankiku/forwward-teams#readme",
  "bugs": {
    "url": "https://github.com/iankiku/forwward-teams/issues"
  },
  "author": "iankiku",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.4.1"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "read-yaml-file": {
      "js-yaml": "^3.15.0"
    }
  }
}
